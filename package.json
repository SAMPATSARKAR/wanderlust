{
  "name": "wanderlust",
  "version": "1.0.0",
  "description": "WanderLust: Rental Booking Platform - MERN Stack",
  "scripts": {
    "start": "node backend/src/server.js",
    "server": "node --watch backend/src/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
